{
  "architecture": "mlp",
  "hidden_layers": 1,
  "hidden_size": 64,
  "hidden_activation": "relu",
  "output_activation": "sigmoid",
  "loss": "mse",
  "optimizer": "adamw",
  "money_scale_rub": 1000000.0,
  "rating_scale": 1000.0,
  "months_to_cashflow_scale": 12.0,
  "features": [
    {
      "index": 0,
      "name": "revenue_monthly_rub",
      "transform": "null → 0, делить на money_scale_rub"
    },
    {
      "index": 1,
      "name": "costs_monthly_rub",
      "transform": "null → 0, делить на money_scale_rub"
    },
    {
      "index": 2,
      "name": "own_funds_rub",
      "transform": "null → 0, делить на money_scale_rub"
    },
    {
      "index": 3,
      "name": "income_confirmed",
      "transform": "0/1"
    },
    {
      "index": 4,
      "name": "costs_confirmed",
      "transform": "0/1"
    },
    {
      "index": 5,
      "name": "capital_confirmed",
      "transform": "0/1"
    },
    {
      "index": 6,
      "name": "loan_amount_rub",
      "transform": "делить на money_scale_rub"
    },
    {
      "index": 7,
      "name": "loan_term_months",
      "transform": "как есть, в месяцах"
    },
    {
      "index": 8,
      "name": "credit_rating",
      "transform": "делить на rating_scale"
    },
    {
      "index": 9,
      "name": "months_to_first_cashflow",
      "transform": "null → 0, делить на months_scale"
    },
    {
      "index": 10,
      "name": "has_contract",
      "transform": "0/1"
    },
    {
      "index": 11,
      "name": "use_of_funds",
      "transform": "0 запуск не сказан, 1 запуск, 2 оборудование, 3 оборотные"
    },
    {
      "index": 12,
      "name": "context_specific",
      "transform": "0/1"
    },
    {
      "index": 13,
      "name": "months_not_stated",
      "transform": "1, если месяцы до потока пустые"
    }
  ],
  "target": "trust",
  "seed": 23,
  "holdout_fraction": 0.2,
  "holdout_mae": 0.0316,
  "holdout_r2": 0.9749,
  "weights_file": "weights.pt",
  "torch": "2.14.1"
}
